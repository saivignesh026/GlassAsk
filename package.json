{
  "name": "glass-ask", "productName": "Glass Ask", "version": "0.1.2",
  "description": "A glass desktop assistant for Windows, powered by your ChatGPT plan.",
  "author": "Glass Ask contributors", "license": "MIT", "private": true,
  "type": "module", "main": "src/main.mjs", "engines": {"node": ">=22"},
  "scripts": {"start": "electron .", "test": "node --test test/*.test.mjs", "test:windows": "electron scripts/smoke-windows.mjs", "check": "node scripts/check.mjs", "dist:win": "electron-builder --win nsis --x64 --publish never"},
  "dependencies": {"jose": "^6.1.0"},
  "devDependencies": {"electron": "^44.0.0", "electron-builder": "26.18.0"},
  "build": {"appId": "io.glassask.desktop", "asar": true, "directories": {"output": "dist"}, "files": ["src/**/*", "ui/**/*", "package.json"], "win": {"icon":"ui/icon.ico", "target": [{"target": "nsis", "arch": ["x64"]}], "artifactName": "Glass-Ask-${version}-Setup.${ext}"}, "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true}}
}
